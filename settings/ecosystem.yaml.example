# Bodai Ecosystem Manifest - EXAMPLE FILE
#
# This is an EXAMPLE file showing the format for settings/ecosystem.yaml.
# Copy this file to settings/ecosystem.yaml and fill in your own values.
# settings/ecosystem.yaml is gitignored - never commit your populated copy.
#
# Mahavishnu loads this via settings/mahavishnu.yaml: `repos_path: settings/ecosystem.yaml`.
# Required fields per repo: name, package, path, role, tags, description, status.
# Optional fields: nickname(s), mcp, publish (for private package indexes).
#
# See settings/README.md, settings/registry_metadata.yaml, and docs/CLI_REFERENCE.md
# (section "Private package indexes") for how Crackerjack consumes publish blocks.

version: '1.0'
maintainer: YOUR_HANDLE          # replace with your handle; never commit populated file
description: Bodai ecosystem repository manifest for this Mahavishnu install.

repos:
  # Replace these example entries with your own repositories.
  # The `path` MUST be the absolute path on THIS machine where the repo is cloned.
  # Wildcard `$HOME` works in path if your loader supports it; otherwise hardcode.

  - name: my-orchestrator
    package: my_orchestrator
    path: /Users/YOU/Projects/my-orchestrator
    nickname: orch
    nicknames: [orch]
    role: orchestrator
    tags: [orchestration, main, python]
    description: Main orchestration repository
    status: active

  - name: my-quality-tool
    package: my_quality_tool
    path: /Users/YOU/Projects/my-quality-tool
    nickname: qc
    nicknames: [qc]
    role: inspector
    tags: [quality, testing, python]
    description: Quality control and testing framework
    status: active

  - name: my-shared-library
    package: my_shared_library
    path: /Users/YOU/Projects/my-shared-library
    nickname: shared
    nicknames: [shared]
    role: foundation
    tags: [library, foundation, python]
    description: Shared utilities and base classes used across repos
    status: active

  # Private package index publish target (optional block).
  # When present, Crackerjack uses `publish.url` as the upload target and
  # resolves `publish.token_env` from your shell environment. Never commit
  # the literal token; the env-var name is documentation only.
  # - name: my-private-pkg
  #   package: my_private_pkg
  #   path: /Users/YOU/Projects/my-private-pkg
  #   nickname: pp
  #   nicknames: [pp]
  #   role: tool
  #   tags: [mcp, python]
  #   description: Example private package
  #   status: active
  #   publish:
  #     url: https://your-private-index.example.com/api/v4/projects/<id>/packages/pypi
  #     token_env: YOUR_PRIVATE_INDEX_TOKEN

# Per-role capability declarations. Roles referenced above map to these blocks.
# This section is mostly shareable across installs (the role taxonomy is global),
# so it can stay in the tracked copy verbatim if you want.

roles:
  - name: orchestrator
    description: Coordinates workflows and manages cross-repository operations
    tags: [coordination, workflow, automation, scheduling]
    capabilities: [sweep, schedule, monitor, route, coordinate]
  - name: resolver
    description: Resolves components, dependencies, and lifecycle
    tags: [dependency-injection, lifecycle, configuration, hot-swap]
    capabilities: [resolve, activate, swap, explain, watch]
  - name: manager
    description: Manages state, sessions, and knowledge across the ecosystem
    tags: [state, knowledge, tracking, analytics]
    capabilities: [capture, search, restore, track, analyze]
  - name: inspector
    description: Validates code quality and enforces development standards
    tags: [quality, testing, validation, ci-cd]
    capabilities: [test, lint, scan, report, validate]
  - name: builder
    description: Builds applications and web interfaces
    tags: [web-framework, ssr, htmx, templates]
    capabilities: [render, route, authenticate, build]
  - name: aggregator
    description: Aggregates data and analytics across distributed systems
    tags: [analytics, aggregation, search, detection]
    capabilities: [aggregate, search, detect, correlate, graph]
  - name: app
    description: End-user applications with graphical interfaces
    tags: [ui, application, user-facing]
    capabilities: [interface, automate, serve-users, integrate]
  - name: asset
    description: UI libraries, component collections, and style guides
    tags: [ui-library, components, styling]
    capabilities: [style, theme, componentize, design]
  - name: foundation
    description: Foundational utilities, libraries, and shared code
    tags: [utilities, library, shared-code]
    capabilities: [share, standardize, abstract, build-upon]
  - name: visualizer
    description: Creates visual diagrams and documentation
    tags: [diagram, visualization, documentation]
    capabilities: [draw, render, visualize, document]
  - name: extension
    description: Extends framework capabilities with pluggable modules
    tags: [extension, plugin, filters, enhancement]
    capabilities: [extend, filter, enhance, plug-in]
  - name: tool
    description: Specialized tools and integrations via MCP protocol
    tags: [mcp, integration, api, service]
    capabilities: [connect, expose, integrate]
  - name: worker
    description: Executes tasks and workflows under orchestrator direction
    tags: [execution, compute, processing, headless]
    duties:
      - Execute headless AI commands
      - Run containerized workloads
      - Report progress and capture output
      - Handle retries, timeouts, and error recovery
    capabilities: [execute, report, retry, timeout, capture]
  - name: seer
    description: Semantic search and knowledge aggregation
    tags: [semantic, search, vector, knowledge]
    capabilities: [aggregate, search, detect, correlate, graph]
  - name: curator
    description: Durable operational state and recovery coordination
    tags: [workflow, config, distribution]
    capabilities: [capture, restore, track, persist, recover]
  - name: orb
    description: Umbrella meta-project aggregating ecosystem configuration and docs

# Coordination state (issues/plans/todos) - typically empty in a fresh manifest.
# Real coordination state lives in Session-Buddy (mcp__session-buddy__coord_* tools);
# only mirror it into this file if you need it checked into version control for
# offline browsing.
# coordination:
#   issues: []
#   plans: []
#   todos: []

# =================== FIELD REFERENCE ===================
#
# Repo fields:
#   name (required):        Human-readable repo name; used as overlay key
#                           in settings/registry_metadata.yaml.
#   package (required):     Python distribution name (use underscores).
#   path (required):        Absolute path to the cloned repo on THIS machine.
#                           Hardcode /Users/<you>/Projects/<repo> - different
#                           installs MUST edit this before use.
#   nickname:               Single-character or short handle.
#   nicknames:              List of additional handles (preferred for plural).
#   role:                   One of the roles below; drives routing and registry
#                           rendering.
#   tags:                   Category tags for filtering.
#   description:            Brief one-paragraph purpose statement.
#   status:                 active | archived | disabled
#   mcp:                    native | 3rd-party - omit if not MCP-related
#   publish (optional):     Private-index upload target.
#     url:                  Package-index endpoint URL.
#     token_env:            NAME of env var holding the bearer token;
#                           never commit the literal token.
#
# Role taxonomy (use one of these values for `role:`):
#   orchestrator | resolver | manager | inspector | builder | aggregator |
#   app | asset | foundation | visualizer | extension | tool | worker |
#   seer | curator | orb
#
# Status values:
#   active    - Repo is part of your day-to-day orchestration.
#   archived  - Repo is retired; surface under "Archived" only.
#   disabled  - Repo is skipped during discovery.
