# Local Mahavishnu Configuration (gitignored)
# Override settings for local development

server_name: "Mahavishnu Local Development"
log_level: DEBUG

# Authentication (for local testing)
auth:
  enabled: true  # Enable auth for local testing
  # Set MAHAVISHNU_AUTH_SECRET environment variable with a strong secret
  algorithm: "HS256"
  expire_minutes: 120  # Longer for local development

# Observability
observability:
  metrics_enabled: false
  tracing_enabled: false

# --- Agno Adapter ---
# Master switch `adapters.agno_enabled` defaults true at settings/mahavishnu.yaml:30.
# The nested block below configures LLM provider, memory backend, and tools.
# Detection: get_health shows adapter="agno" with agents_cached=0, mcp_tools_initialized=false
# Required env vars: MAHAVISHNU_AGNO__LLM__API_KEY, MAHAVISHNU_AGNO__LLM__PROVIDER
# See: docs/runbooks/agno-adapter-initialization.md
# adapters:
#   agno_enabled: true
#
# agno:
#   llm:
#     provider: minimax  # anthropic, openai, minimax, llama_server
#     model_id: MiniMax-M3
#     # api_key read from MAHAVISHNU_AGNO__LLM__API_KEY
#     base_url: "http://localhost:8081"  # for llama_server
#   memory:
#     backend: sqlite  # sqlite, postgres, none
#     # connection_string required if backend=postgres, set via MAHAVISHNU_AGNO__MEMORY__CONNECTION_STRING
#   telemetry_enabled: false

# --- Terminal Adapters ---
# Two adapters are wired for local development. tmux is the default
# (adapter_preference: "tmux" is inherited from settings/mahavishnu.yaml:294
# and needs no opt-in — it's the always-on DurableWorkerManager path).
# crow requires the explicit `crow_enabled: true` flag; without it
# the manager falls through to the mock adapter rather than crashing
# (see mahavishnu/terminal/config.py:70-78). Both adapters are
# registered, and `terminal_switch_adapter` (MCP tool) or a local.yaml
# override of `adapter_preference` can flip between them at runtime.
# Crow needs the bundled crow-mcp HTTP server reachable on
# 127.0.0.1:8693 (CLAUDE.md portmap — 8693 was moved off 8675 to
# avoid colliding with Prefect's local uvicorn).
# Env-var overrides: MAHAVISHNU_TERMINAL__CROW_ENABLED, MAHAVISHNU_CROW_HTTP_HOST, MAHAVISHNU_CROW_HTTP_PORT.
# See: docs/runbooks/crow-adapter-mcp-client.md
# terminal:
#   # adapter_preference: "tmux"  # default; switch to "crow" to make crow the active adapter
#   crow_enabled: true   # OPT IN to enable the crow adapter (CLI wires mcp_client)
#   crow_http_host: "127.0.0.1"
#   crow_http_port: 8693

# --- OpenSearch Observability Backend ---
# Auto-detected: the integration tries to connect at startup and falls back to
# in-memory storage if OpenSearch is unreachable. No dev/prod decision needed —
# set the endpoint and the system handles the rest.
#
# Homebrew install (macOS):
#   brew install opensearch
#   brew services start opensearch
# Default endpoint is https://localhost:9200 with a self-signed cert, so for dev
# either disable cert verification OR trust the Homebrew root CA:
#   export MAHAVISHNU_OPENSEARCH__VERIFY_CERTS=false
#   # OR
#   export MAHAVISHNU_OPENSEARCH__CA_CERTS=/opt/homebrew/etc/opensearch/root-ca.pem
# NEVER disable verify_certs in production.
# Detection: get_health shows opensearch_healthy=false, opensearch_info.status="unhealthy"
# See: docs/runbooks/opensearch-fallback.md
# opensearch:
#   endpoint: "https://localhost:9200"
#   use_ssl: true
#   verify_certs: false  # dev-only; set true with ca_certs in production
#   ssl_assert_hostname: false
#   opensearch_log_index: "mahavishnu-logs"
#   opensearch_workflow_index: "mahavishnu-workflows"

# --- OpenTelemetry Ingester (Phase 10: pgvector live) ---
# Production trace storage: PostgreSQL + pgvector. Requires `vector`
# extension (Postgres 16/17/18). Default storage_type is "duckdb" (in-memory
# or file-backed); switch to "postgresql" for cross-instance semantic search.
# Local dev quickstart (Homebrew postgresql@18 + pgvector):
#   brew install postgresql@18 pgvector
#   brew services start postgresql@18
#   createdb mahavishnu_otel
#   psql -d mahavishnu_otel -c "CREATE EXTENSION vector;"
# Env-var equivalents: MAHAVISHNU__OTEL_INGESTER__STORAGE__TYPE,
# MAHAVISHNU__OTEL_INGESTER__STORAGE__PG_URL.
# See: docs/plans/2026-09-16-pgvector-live.md
# otel_ingester:
#   enabled: true
#   storage_type: "postgresql"  # "duckdb" (default) or "postgresql"
#   storage_pg_url: "postgresql://CHANGE_ME_USER:CHANGE_ME_PASSWORD@CHANGE_ME_HOST:5432/mahavishnu_otel"