{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "drop_excess_requests": false
  },
  "config_store": {
    "config": {
      "path": "./config.db"
    },
    "enabled": true,
    "type": "sqlite"
  },
  "governance": {
    "routing_rules": [
      {
        "cel_expression": "headers[\"x-bf-route\"] == \"anthropic_native\"",
        "description": "Pin Claude Code to the Anthropic-native MiniMax provider. The gateway config defines two providers that both claim MiniMax-M3, and bare model-name resolution cannot choose between them: the OpenAI-compatible one returns reasoning inline in the assistant text, while this one returns genuine Anthropic responses with thinking blocks. The target pins the provider only -- upstream keeps the incoming model when a target omits it -- because Claude Code picks the model per request class (MiniMax-M3 for the opus and sonnet slots, MiniMax-M3.1-Flash for the haiku slot) and a pinned model would silently move the fast slot onto the heavy model. The fallback stays on the Anthropic-native provider: the Anthropic ingress bridges every request to the 'responses' request type, which the chat-completions-only 'minimax-openai' provider cannot serve.",
        "enabled": true,
        "fallbacks": [
          "minimax-anthropic/MiniMax-M3.1-Flash"
        ],
        "id": "route-anthropic-native",
        "name": "Anthropic-Native Claude Code Route",
        "priority": 5,
        "scope": "global",
        "targets": [
          {
            "provider": "minimax-anthropic",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"think\" || headers[\"x-bf-route\"] == \"think\"",
        "description": "Route high-reasoning tasks to MiniMax's strongest text model.",
        "enabled": true,
        "fallbacks": [
          "minimax-openai/MiniMax-M3.1-Flash"
        ],
        "id": "route-think",
        "name": "Think Tasks",
        "priority": 10,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"long_context\" || headers[\"x-bf-route\"] == \"long_context\" || headers[\"x-bf-task\"] == \"longContext\" || headers[\"x-bf-route\"] == \"longContext\"",
        "description": "Prefer the strongest MiniMax text model for explicitly labeled long-context work.",
        "enabled": true,
        "fallbacks": [
          "minimax-openai/MiniMax-M3.1-Flash"
        ],
        "id": "route-long-context",
        "name": "Long Context Tasks",
        "priority": 20,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"web_search\" || headers[\"x-bf-route\"] == \"web_search\" || headers[\"x-bf-task\"] == \"webSearch\" || headers[\"x-bf-route\"] == \"webSearch\"",
        "description": "Prefer MiniMax's stronger text model when the caller marks a browsing or search-heavy request.",
        "enabled": true,
        "fallbacks": [
          "minimax-openai/MiniMax-M3"
        ],
        "id": "route-web-search",
        "name": "Web Search Tasks",
        "priority": 30,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3.1-Flash",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"image\" || headers[\"x-bf-route\"] == \"image\"",
        "description": "Route vision requests to MiniMax's multimodal model. Both M3 and M3.1-Flash accept image input on the OpenAI-compatible surface (image_url blocks, verified live against this gateway on 2026-11-06); M3.1-Flash is the cheaper of the two and read charts and documents with equal accuracy in an A/B on 2026-11-06.",
        "enabled": true,
        "fallbacks": [
          "minimax-openai/MiniMax-M3"
        ],
        "id": "route-image",
        "name": "Vision Tasks",
        "priority": 40,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3.1-Flash",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"background\" || headers[\"x-bf-route\"] == \"background\" || headers[\"x-bf-task\"] == \"cheap\" || headers[\"x-bf-route\"] == \"cheap\" || headers[\"x-bf-task\"] == \"high_throughput\" || headers[\"x-bf-route\"] == \"high_throughput\"",
        "description": "Route low-priority background work to MiniMax-M3.1-Flash; fall back to the local llama-server (qwen3-8b-q4_k_m) when the cloud provider is unreachable. Phase G.",
        "enabled": true,
        "fallbacks": [
          "llama-server/qwen3-8b-q4_k_m"
        ],
        "id": "route-background",
        "name": "Background Tasks",
        "priority": 50,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3.1-Flash",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      },
      {
        "cel_expression": "headers[\"x-bf-task\"] == \"classify\" || headers[\"x-bf-route\"] == \"classify\" || headers[\"x-bf-task\"] == \"extract\" || headers[\"x-bf-route\"] == \"extract\"",
        "description": "Route cheap classification and extraction tasks to MiniMax-M3.1-Flash; fall back to the local llama-server (qwen3-8b-q4_k_m) when the cloud provider is unreachable. Phase G.",
        "enabled": true,
        "fallbacks": [
          "llama-server/qwen3-8b-q4_k_m"
        ],
        "id": "route-classify",
        "name": "Classify / Extract Tasks",
        "priority": 60,
        "scope": "global",
        "targets": [
          {
            "model": "MiniMax-M3.1-Flash",
            "provider": "minimax-openai",
            "weight": 1
          }
        ]
      }
    ]
  },
  "plugins": [
    {
      "config": {
        "cache_by_model": true,
        "cache_by_provider": true,
        "cleanup_on_shutdown": true,
        "conversation_history_threshold": 16,
        "dimension": 1536,
        "embedding_model": "text-embedding-3-small",
        "exclude_system_prompt": false,
        "provider": "openai",
        "threshold": 0.95,
        "ttl": "30m"
      },
      "enabled": true,
      "name": "semantic_cache"
    }
  ],
  "providers": {
    "llama-server": {
      "custom_provider_config": {
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "base_provider_type": "openai",
        "request_path_overrides": {
          "chat_completion": "/v1/chat/completions",
          "chat_completion_stream": "/v1/chat/completions"
        }
      },
      "keys": [
        {
          "models": [
            "qwen3-8b-q4_k_m",
            "qwen3.5"
          ],
          "name": "llama-server-local",
          "value": "env.LLAMA_SERVER_API_KEY",
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "http://127.0.0.1:8081"
      }
    },
    "minimax-anthropic": {
      "custom_provider_config": {
        "allowed_requests": {
          "count_tokens": true,
          "responses": true,
          "responses_stream": true
        },
        "base_provider_type": "anthropic",
        "request_path_overrides": {
          "count_tokens": "/anthropic/v1/messages/count_tokens",
          "responses": "/anthropic/v1/messages",
          "responses_stream": "/anthropic/v1/messages"
        }
      },
      "keys": [
        {
          "models": [
            "MiniMax-M3",
            "MiniMax-M3.1-Flash",
            "claude-opus-5-5",
            "claude-opus-5.5",
            "claude-opus-4-6",
            "claude-sonnet-5-5",
            "claude-sonnet-4-6",
            "claude-sonnet-4.6",
            "claude-haiku-5-5",
            "claude-haiku-4-5",
            "claude-fable-5-1",
            "claude-mythos-5-1"
          ],
          "aliases": {
            "claude-opus-5-5": "MiniMax-M3",
            "claude-opus-5.5": "MiniMax-M3",
            "claude-opus-4-6": "MiniMax-M3",
            "claude-sonnet-5-5": "MiniMax-M3.1-Flash",
            "claude-sonnet-4-6": "MiniMax-M3.1-Flash",
            "claude-sonnet-4.6": "MiniMax-M3.1-Flash",
            "claude-haiku-5-5": "MiniMax-M3.1-Flash",
            "claude-haiku-4-5": "MiniMax-M3.1-Flash",
            "claude-fable-5-1": "MiniMax-M3",
            "claude-mythos-5-1": "MiniMax-M3"
          },
          "name": "minimax-anthropic-primary",
          "value": "env.MINIMAX_API_KEY",
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.minimax.io"
      }
    },
    "minimax-openai": {
      "custom_provider_config": {
        "allowed_requests": {
          "chat_completion": true,
          "chat_completion_stream": true
        },
        "base_provider_type": "openai",
        "request_path_overrides": {
          "chat_completion": "/v1/chat/completions",
          "chat_completion_stream": "/v1/chat/completions"
        }
      },
      "keys": [
        {
          "models": [
            "MiniMax-M3",
            "MiniMax-M3.1-Flash",
            "claude-opus-5-5",
            "claude-opus-5.5",
            "claude-opus-4-6",
            "claude-sonnet-5-5",
            "claude-sonnet-4-6",
            "claude-sonnet-4.6",
            "claude-haiku-5-5",
            "claude-haiku-4-5",
            "claude-fable-5-1",
            "claude-mythos-5-1"
          ],
          "aliases": {
            "claude-opus-5-5": "MiniMax-M3",
            "claude-opus-5.5": "MiniMax-M3",
            "claude-opus-4-6": "MiniMax-M3",
            "claude-sonnet-5-5": "MiniMax-M3.1-Flash",
            "claude-sonnet-4-6": "MiniMax-M3.1-Flash",
            "claude-sonnet-4.6": "MiniMax-M3.1-Flash",
            "claude-haiku-5-5": "MiniMax-M3.1-Flash",
            "claude-haiku-4-5": "MiniMax-M3.1-Flash",
            "claude-fable-5-1": "MiniMax-M3",
            "claude-mythos-5-1": "MiniMax-M3"
          },
          "name": "minimax-openai-primary",
          "value": "env.MINIMAX_API_KEY",
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.minimax.io"
      }
    },
    "openai": {
      "keys": [
        {
          "models": [
            "gpt-5.4",
            "gpt-5.4-mini",
            "gpt-5.3-codex",
            "text-embedding-3-small"
          ],
          "name": "openai-primary",
          "value": "env.OPENAI_API_KEY",
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://api.openai.com"
      }
    }
  },
  "vector_store": {
    "config": {
      "addr": "localhost:6379"
    },
    "enabled": true,
    "type": "redis"
  }
}
