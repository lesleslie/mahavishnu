#!/usr/bin/env bash
# Mahavishnu pre-commit hook — wired via core.hooksPath.
#
# Runs scripts/audit_no_secrets_in_mcp.py on every commit that touches
# a .mcp.json file. Enforces the rule from
# .claude/decisions/2026-08-24-bodai-mcp-routing-pattern.md §1:
#
#     Any environment variable whose name ends in KEY, TOKEN, SECRET,
#     PASSWORD, or otherwise names a credential MUST come from the
#     parent shell's environment — never from a literal value in
#     any .mcp.json.
#
# Setup (one-time per clone):
#     git config core.hooksPath .githooks
#
# Bypass (when you know what you're doing):
#     git commit --no-verify

set -euo pipefail

# Only run if any staged file is a .mcp.json.
changed_mcp_json=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.mcp\.json$' || true)

if [[ -z "${changed_mcp_json}" ]]; then
    exit 0
fi

echo "pre-commit: scanning ${changed_mcp_json} for hardcoded secrets..."

# Run the audit script. cwd is the repo root (git hook convention).
# Pass an explicit list of files so we only scan the changed ones
# (faster than the default ecosystem-wide scan).
# The script accepts paths as positional args.
python3 scripts/audit_no_secrets_in_mcp.py ${changed_mcp_json}